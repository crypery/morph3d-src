// =====================================================================
//  morph3d.rc - ресурсы Morph3D: иконка, версия (info), манифест
//  Компилируется windres -> morph3d.o, линкуется в morph3d.exe
// =====================================================================
#include <windows.h>

// ---------- Иконка ----------
IDI_MORPH3D   ICON    "icon.ico"

// ---------- Манифест (DPI, UAC, Common Controls, совместимость) ----------
1   RT_MANIFEST   "morph3d.manifest"

// ---------- Версия / info (описание на английском) ----------
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Morph3D"
            VALUE "FileDescription",  "Morph3D - Top Morphing 3D Point Screensaver"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "morph3d"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Morph3D"
            VALUE "OriginalFilename", "morph3d.exe"
            VALUE "ProductName",      "Morph3D Screensaver"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "A top-tier Windows screensaver: morphing neon point figures (torus, sphere, octahedron, dodecahedron, prism, cylinder) with smooth transitions, glowing trails, spiral motion and an immersive presence effect."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
